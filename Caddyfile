# Caddyfile — DeepSeek Harness fork
#
# Terminates TLS in front of the dsh container and reverse-proxies over the
# docker internal network. dsh itself stays bound to its default port but
# no longer accepts host traffic directly.
#
# TLS certs are minted by a one-shot init container (cert_init) using
# openssl with both trusted-host IPs in the SAN. Browser will warn once
# (self-signed, not trusted CA) and let the user proceed.

{
    admin off
}

# HTTPS entry — explicit self-signed cert (SAN = both trusted IPs)
:443 {
    tls /data/cert.pem /data/key.pem
    # Upstream is dsh itself on 3080. Since upstream 0.1.2-alpha.1 dsh
    # natively authenticates the browser (launch token → 30-day signed
    # cookie, see FORK_CHANGES §6.0), so the old dsh-passwords gateway on
    # 8080 was removed. Plain HTTP inside the docker network, TLS here.
    # Container-name form: compose 2.40.3 drops service aliases on recreate.
    reverse_proxy deepseek-harness-dsh:3080
}

# HTTP → HTTPS redirect (container-internal only — host port 80 is taken
# by cloudlink-finder, so we skip the host-side 80 mapping)
:80 {
    redir https://{host}{uri} permanent
}
